# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Supabase project URL (found in your Supabase project settings > API)
SUPABASE_URL=https://your-project.supabase.co

# Supabase service-role key — server-side only. NEVER expose to frontend.
# Found in Supabase project settings > API > service_role key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Port the NestJS API listens on. Defaults to 3001 if not set (ADR-0001).
PORT=3001

# Runtime environment
NODE_ENV=development

# ---------------------------------------------------------------------------
# Brevo email integration (ADR-0007, docs/runbooks/supabase-project-setup.md)
# ---------------------------------------------------------------------------

# Brevo SMTP credentials — used by Supabase Auth to send magic link emails.
# BREVO_SMTP_USER: your Brevo account login email (e.g. you@example.com).
# Found in: Brevo Dashboard > SMTP & API > SMTP tab > Login.
BREVO_SMTP_USER=your-brevo-login-email@example.com

# BREVO_SMTP_PASS: the SMTP key generated in Brevo Dashboard.
# WARNING: this is NOT your Brevo account password and NOT the HTTP API key.
# Found in: Brevo Dashboard > SMTP & API > SMTP tab > SMTP key (generate one if needed).
# SECURITY: any key previously pasted in chat is considered compromised - regenerate before use.
# See docs/runbooks/supabase-project-setup.md for the full procedure.
BREVO_SMTP_PASS=your-brevo-smtp-key-here

# BREVO_API_KEY: the Brevo HTTP API key used by NestJS for programmatic email send
# (e.g. booking confirmations, notifications - not auth magic links).
# Found in: Brevo Dashboard > SMTP & API > API Keys tab.
# SECURITY: any key previously pasted in chat is considered compromised - regenerate before use.
BREVO_API_KEY=your-brevo-api-key-here

# ---------------------------------------------------------------------------
# Platform administration
# ---------------------------------------------------------------------------

# ADMIN_EMAILS: comma-separated list of platform admin email addresses.
# These accounts receive platform-level notifications and may have elevated access.
# Example: "admin@example.com,backup-admin@example.com"
ADMIN_EMAILS=your-admin-email@example.com
