{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./apps/api/.env)",
      "Read(./apps/api/.env.*)",
      "Read(./apps/web/.env)",
      "Read(./apps/web/.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/id_rsa*)",
      "Read(./**/credentials*)",
      "Bash(git push origin main*)",
      "Bash(git push --force*)",
      "Bash(rm -rf /*)",
      "Bash(supabase db reset --linked*)",
      "Bash(supabase db push --linked*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(supabase db*)",
      "Bash(pnpm publish*)",
      "Bash(npm publish*)",
      "Bash(vercel deploy*)",
      "Bash(vercel --prod*)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)"
    ],
    "allow": [
      "Read(./**)",
      "Write(./apps/**)",
      "Write(./packages/**)",
      "Write(./docs/**)",
      "Write(./.github/workflows/**)",
      "Edit(./apps/**)",
      "Edit(./packages/**)",
      "Edit(./docs/**)",
      "Edit(./.github/workflows/**)",
      "Bash(pnpm install*)",
      "Bash(pnpm i)",
      "Bash(pnpm lint*)",
      "Bash(pnpm test*)",
      "Bash(pnpm build*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm dev*)",
      "Bash(pnpm run *)",
      "Bash(pnpm exec *)",
      "Bash(turbo run *)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git checkout*)",
      "Bash(git branch*)",
      "Bash(git pull*)",
      "Bash(git stash*)",
      "Bash(git restore*)",
      "Bash(git switch*)",
      "Bash(gh pr create*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr checkout*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr comment*)",
      "Bash(gh pr review*)",
      "Bash(gh pr merge * --squash*)",
      "Bash(gh pr merge * --merge*)",
      "Bash(gh pr merge * --rebase*)",
      "Bash(gh issue *)",
      "Bash(gh repo view*)",
      "Bash(gh run *)",
      "Bash(gh workflow *)",
      "Bash(supabase status)",
      "Bash(supabase start)",
      "Bash(supabase stop)",
      "Bash(supabase migration list)",
      "Bash(supabase migration new *)",
      "Bash(supabase db reset)",
      "Bash(supabase gen types *)",
      "Bash(node *)",
      "Bash(npx *)",
      "Bash(ls*)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(tree*)",
      "Bash(jq *)",
      "Bash(echo *)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(mkdir -p *)",
      "Bash(touch *)",

      "Write(./package.json)",
      "Edit(./package.json)",
      "Write(./pnpm-workspace.yaml)",
      "Edit(./pnpm-workspace.yaml)",
      "Write(./turbo.json)",
      "Edit(./turbo.json)",
      "Write(./tsconfig.base.json)",
      "Edit(./tsconfig.base.json)",
      "Write(./.nvmrc)",
      "Edit(./.nvmrc)",
      "Write(./.editorconfig)",
      "Edit(./.editorconfig)",
      "Write(./.prettierrc)",
      "Edit(./.prettierrc)",
      "Write(./.prettierignore)",
      "Edit(./.prettierignore)",
      "Write(./.gitignore)",
      "Edit(./.gitignore)",
      "Write(./README.md)",
      "Edit(./README.md)",

      "Write(./eslint.config.js)",
      "Edit(./eslint.config.js)",
      "Write(./eslint.config.mjs)",
      "Edit(./eslint.config.mjs)",
      "Write(./eslint.config.cjs)",
      "Edit(./eslint.config.cjs)",
      "Write(./eslint.config.ts)",
      "Edit(./eslint.config.ts)",

      "Write(./commitlint.config.js)",
      "Edit(./commitlint.config.js)",
      "Write(./commitlint.config.mjs)",
      "Edit(./commitlint.config.mjs)",
      "Write(./commitlint.config.cjs)",
      "Edit(./commitlint.config.cjs)",
      "Write(./commitlint.config.ts)",
      "Edit(./commitlint.config.ts)",

      "Write(./vitest.config.ts)",
      "Edit(./vitest.config.ts)",
      "Write(./vitest.config.mts)",
      "Edit(./vitest.config.mts)",
      "Write(./vitest.config.js)",
      "Edit(./vitest.config.js)",
      "Write(./vitest.config.mjs)",
      "Edit(./vitest.config.mjs)",

      "Write(./supabase/**)",
      "Edit(./supabase/**)",
      "Write(./.husky/**)",
      "Edit(./.husky/**)",

      "Bash(pnpm exec husky *)",
      "Bash(pnpm exec lint-staged *)",
      "Bash(pnpm exec commitlint *)",
      "Bash(supabase init*)",
      "Bash(supabase test *)",
      "Bash(corepack *)"
    ],
    "defaultMode": "default"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "if [[ \"$CLAUDE_FILE_PATH\" == *.ts || \"$CLAUDE_FILE_PATH\" == *.tsx ]]; then cd \"$CLAUDE_PROJECT_DIR\" && pnpm exec prettier --write \"$CLAUDE_FILE_PATH\" 2>/dev/null || true; fi"
          }
        ]
      }
    ]
  },
  "env": {
    "NODE_ENV": "development"
  }
}
